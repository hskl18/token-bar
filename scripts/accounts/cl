#!/usr/bin/env python3
"""Start Claude Code (`cl`) or Codex (`cdx`) on the login whose quota should be used first.

The logins are ~/.claude and every signed-in ~/.claude-* folder, and ~/.codex and every signed-in ~/.codex-*
folder, found the way Token Bar finds them. Each login's quota is read live; a login that cannot be read
uses the newer of its last live reading and Token Bar's. Once claude-share-projects and codex-share-home
share the history, `cl --continue` or `cdx resume --last` picks up on whichever login has room.
"""
import hashlib
import json
import os
import plistlib
import re
import shutil
import sqlite3
import subprocess
import sys
import threading
import time
import tomllib
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime

HOME = os.path.expanduser("~")
CLAUDE, CODEX = shutil.which("claude"), shutil.which("codex")
# Arguments every `cdx` run passes before yours, such as ["-c", 'model="<model>"'].
CODEX_ARGS = []
APPLE_EPOCH = 978307200  # Token Bar saves dates as seconds since 2001-01-01.
# Each login's last live reading, for when a login cannot be read live.
CACHE = f"{HOME}/.cache/cl/quota.json"
# One JSON line per launch: the pick, which readings were live, and any shared-history problem.
LOG = f"{HOME}/.cache/cl/launch.log"
# What the merge scripts link from each extra login to the primary one.
SHARED = {"cl": ["projects", "file-history", "paste-cache", "session-env"],
          "cdx": ["sessions", "archived_sessions", "thread-writer-locks", "history.jsonl", "session_index.jsonl",
                  ".tmp/rollout-maintenance.lock"]}
# A login is comfortable with this much room in its tightest window, in percent of a Pro-sized window.
RESERVE = 40
# Pro-sized windows per Claude plan, from `organizationRateLimitTier`; estimates, since only the 5-hour ratio is published.
TIERS = {"default_claude_max_5x": 5, "default_claude_max_20x": 20}
UUID = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")


def logins(primary, prefix, markers):
    """The primary folder, then each top-level ~/<prefix>* folder holding a sign-in file (AccountSource.detected)."""
    found = [primary]
    for name in sorted(os.listdir(HOME)):
        folder = os.path.join(HOME, name)
        if (name.startswith(prefix) and os.path.isdir(folder) and not os.path.islink(folder)
                and any(os.path.isfile(f"{folder}/{marker}") and not os.path.islink(f"{folder}/{marker}")
                        for marker in markers)):
            found.append(folder)
    return found


def codex_model(home, args):
    """The model Codex will run: the last -m or --model, else the last -c model=, else the config's.

    shortcut: ignores --profile and the --model=<name> spelling; such runs are judged by the config's model.
    """
    picked = override = None
    for flag, value in zip(args, args[1:]):
        if flag in ("-m", "--model"):
            picked = value
        elif flag in ("-c", "--config") and value.partition("=")[0].strip() == "model":
            override = value.partition("=")[2].strip().strip("\"'")
    if picked or override:
        return picked or override
    try:
        with open(f"{home}/config.toml", "rb") as file:
            return tomllib.load(file).get("model")
    except (OSError, tomllib.TOMLDecodeError):
        return None


def claude_usage(home):
    """Claude's own reading for the login, or None without a current login token."""
    service = "Claude Code-credentials"
    if home != f"{HOME}/.claude":
        service += "-" + hashlib.sha256(home.encode()).hexdigest()[:8]
    try:
        found = subprocess.run(
            ["security", "find-generic-password", "-a", os.environ["USER"], "-s", service, "-w"],
            capture_output=True, text=True, timeout=5,
        )
        # 44 is errSecItemNotFound: signed out, so only a last resort, like a full login.
        # Any other failure, such as a locked Keychain, stays unknown.
        if found.returncode == 44:
            return False, [(100, None)], None
        oauth = json.loads(found.stdout)["claudeAiOauth"]
        if oauth["expiresAt"] / 1000 < time.time() + 60:
            return None  # Only Claude Code may refresh it; a refresh here would rotate its login away.
        request = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
            "Authorization": "Bearer " + oauth["accessToken"], "anthropic-beta": "oauth-2025-04-20",
        })
        usage = json.load(urllib.request.urlopen(request, timeout=3))
    except Exception:
        return None
    timed = [w for w in (usage.get("five_hour"), usage.get("seven_day")) if w]
    # Credit-only plans, such as the Enterprise trial, have no time windows.
    found = timed or [w for w in [usage.get("extra_usage")] if w]
    weekly = (usage.get("seven_day") or {}).get("resets_at")
    return (bool(timed), [(w.get("utilization") or 0, w.get("resets_at") and datetime.fromisoformat(w["resets_at"]).timestamp())
                          for w in found], weekly and datetime.fromisoformat(weekly).timestamp())


def codex_usage(home):
    """Codex's own reading for the login, from its app-server, or None."""
    if not CODEX:
        return None
    env = {key: value for key, value in os.environ.items() if key not in TOOLS["cdx"]["credentials"]}
    env["CODEX_HOME"] = home

    def call(server, message):
        server.stdin.write(json.dumps(message) + "\n")
        server.stdin.flush()
        for line in server.stdout:
            reply = json.loads(line)
            if reply.get("id") == message["id"]:
                return reply

    try:
        server = subprocess.Popen([CODEX, "app-server", "--stdio"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                  stderr=subprocess.DEVNULL, env=env, cwd=home, text=True)
    except OSError:
        return None
    # A cold start over a large shared history took 4-6 s in testing, against about 1 s warm.
    timer = threading.Timer(10, server.kill)
    timer.start()
    try:
        call(server, {"method": "initialize", "id": 1, "params": {"clientInfo": {"name": "cdx", "title": "cdx", "version": "1"}}})
        server.stdin.write(json.dumps({"method": "initialized", "params": {}}) + "\n")
        reply = call(server, {"method": "account/rateLimits/read", "id": 2, "params": {"excludeResetCreditDetails": True}})
        if "authentication" in str((reply or {}).get("error", {}).get("message", "")):
            return False, [(100, None)], None  # Signed out: only a last resort, like a full login.
        result = reply["result"]
        limits = (result.get("rateLimitsByLimitId") or {}).get("codex") or result["rateLimits"]
    except Exception:
        return None
    finally:
        timer.cancel()
        server.kill()
        server.wait()
    credits = limits.get("credits") or {}
    banner = result.get("rateLimitUpsell") or {}
    # Codex's own tests for a usable login (tui backend_banners.rs): percentages alone cannot show a block.
    # A block stays a full window with no reset, so a saved reading never expires into a free one.
    blocked = (result.get("ordinaryUsageAllowed") is False and not (credits.get("unlimited") or credits.get("hasCredits"))
               or limits.get("spendControlReached") is True or limits.get("rateLimitReachedType") is not None)
    windows = [w for w in (limits.get("primary"), limits.get("secondary")) if w]
    found = [(w.get("usedPercent") or 0, w.get("resetsAt")) for w in windows] + ([(100, None)] if blocked else [])
    # A limit on the model this run uses blocks the login until the banner's reset.
    model = codex_model(home, CODEX_ARGS + sys.argv[1:])
    if (model and model in (banner.get("blocked_model_slug"), banner.get("model_slug"))
            and banner.get("banner_type") == "selected_model_limit"):
        found.append((100, banner.get("reset_at")))
    return bool(windows), found, next((w.get("resetsAt") for w in windows if w.get("windowDurationMins") == 7 * 24 * 60), None)


def session_by_name(args, homes):
    """`cdx resume <name>` or `fork <name>` with that session's ID, once the Codex logins share one history.

    Codex looks a name up only among sessions whose files sit under the running login's own folder,
    which misses every session the other login started.
    shortcut: matches session names only, not Codex's fallback to a first message, and only right after the
    subcommand; pass the session ID for anything else.
    """
    if (len(args) < 2 or args[0] not in ("resume", "fork") or args[1].startswith("-") or UUID.match(args[1])
            or not any(os.path.islink(f"{home}/sessions") for home in homes[1:])):
        return args
    try:
        db = sqlite3.connect(f"file:{HOME}/.codex/state_5.sqlite?mode=ro", uri=True)
        ids = [row[0] for row in db.execute("SELECT id FROM threads WHERE trim(name) = ? AND archived = 0", (args[1],))]
        db.close()
    except sqlite3.Error:
        return args
    if len(ids) > 1:
        sys.exit(f"cdx: Multiple sessions match '{args[1]}' (including {ids[0]} and {ids[1]}); use a session UUID.")
    return [args[0], ids[0], *args[2:]] if ids else args


TOOLS = {
    "cl": {
        "homes": logins(f"{HOME}/.claude", ".claude-", [".claude.json", ".credentials.json"]),
        "variable": "CLAUDE_CONFIG_DIR",
        # Naming ~/.claude would make Claude Code read another Keychain entry, so it stays unset.
        "unnamed": f"{HOME}/.claude",
        "program": [CLAUDE],
        # Inherited credentials would override the picked login.
        "credentials": ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"),
        "snapshot": ("claude", "additionalClaudeAccounts"),
        "live": claude_usage,
        "weight": lambda home: claude_weight(home),
    },
    "cdx": {
        "homes": logins(f"{HOME}/.codex", ".codex-", ["auth.json", "config.toml"]),
        "variable": "CODEX_HOME",
        "unnamed": None,
        "program": [CODEX, *CODEX_ARGS],
        "credentials": ("CODEX_ACCESS_TOKEN", "CODEX_API_KEY", "OPENAI_API_KEY", "CODEX_SQLITE_HOME"),
        "snapshot": ("codex", "additionalCodexAccounts"),
        "live": codex_usage,
        "weight": lambda home: 1,  # Codex readings name no plan size; equal plans are assumed.
    },
}


def saved_readings(tool):
    """The newest saved reading per login, from this launcher's cache or Token Bar: {home: (time, reading)}."""
    try:
        with open(CACHE) as file:
            saved = {home: (entry["at"], (entry["timed"], [tuple(w) for w in entry["windows"]], entry.get("weekly")))
                     for home, entry in json.load(file).items()}
    except (OSError, ValueError, KeyError, TypeError):
        saved = {}
    primary, others = tool["snapshot"]
    try:
        export = subprocess.run(["defaults", "export", "com.local.tokenbar", "-"],
                                capture_output=True, timeout=5).stdout
        snapshot = json.loads(plistlib.loads(export)["tokenbar.snapshot.v1"])
    except Exception:
        return saved
    quotas = [(tool["homes"][0], snapshot.get(primary))]
    quotas += [(account.get("sourceDirectory"), account.get("quota")) for account in snapshot.get(others) or []]
    for home, quota in quotas:
        at = quota and quota.get("lastSuccessAt")
        if at is not None and at + APPLE_EPOCH > saved.get(home, (0,))[0]:
            saved[home] = (at + APPLE_EPOCH, token_bar_windows(quota))
    return saved


def save_readings(readings, now):
    """Remember live readings; another launcher writing at once only costs one reading."""
    try:
        with open(CACHE) as file:
            cache = json.load(file)
    except (OSError, ValueError):
        cache = {}
    cache.update({home: {"at": now, "timed": timed, "windows": windows, "weekly": weekly}
                  for home, (timed, windows, weekly) in readings.items()})
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        with open(CACHE + f".{os.getpid()}", "w") as file:
            json.dump(cache, file)
        os.replace(CACHE + f".{os.getpid()}", CACHE)
    except OSError:
        pass  # The cache only helps a later launch; never block this one.


def token_bar_windows(quota):
    timed = [w for w in (quota.get("shortWindow"), quota.get("longWindow")) if w]
    found = timed or [w for w in quota.get("extraWindows") or [] if w.get("limitID") == "claude:extra_usage"]
    weekly = next((w["resetsAt"] + APPLE_EPOCH for w in timed
                   if w.get("windowMinutes") == 7 * 24 * 60 and w.get("resetsAt") is not None), None)
    return (bool(timed), [(w.get("usedPercent") or 0, None if w.get("resetsAt") is None else w["resetsAt"] + APPLE_EPOCH)
                          for w in found], weekly)


def room(windows, now):
    """Percent left in the tightest window that has not reset yet."""
    return min((100 - used for used, reset in windows if reset is None or reset > now), default=100)


def wait(windows, now):
    """Seconds until every full window resets: infinite when a reset time is unknown."""
    return max((float("inf") if reset is None else max(0, reset - now)
                for used, reset in windows if used >= 100), default=0)


def claude_weight(home):
    """How many Pro-sized windows the login's plan holds; an unknown or unreadable plan counts as one."""
    path = f"{HOME}/.claude.json" if home == f"{HOME}/.claude" else f"{home}/.claude.json"
    try:
        with open(path) as file:
            return TIERS.get((json.load(file).get("oauthAccount") or {}).get("organizationRateLimitTier"), 1)
    except (OSError, ValueError, AttributeError):
        return 1


def expires(reading, now):
    """When the login's weekly quota expires unused: its weekly reset, or its latest known reset for a saved
    reading taken before readings recorded the weekly one. A saved weekly reset that has passed says nothing
    about the new week, so that login comes last."""
    timed, windows, weekly = reading
    if weekly:
        return weekly if weekly > now else float("inf")
    return max((reset for used, reset in windows if reset and reset > now), default=float("inf"))


def pick(homes, readings, weights, now):
    """Among time-window logins with a comfortable reserve, the one whose weekly quota resets first, ties going
    to the most room; then the most room in Pro-sized units; then credit-only or unread logins by room;
    else the one that frees up first."""
    usable = [h for h in homes if room(readings[h][1], now) > 0]
    timed = [h for h in usable if readings[h][0]]
    if timed:
        weighted = lambda h: room(readings[h][1], now) * weights[h]
        comfortable = [h for h in timed if weighted(h) >= RESERVE]
        if comfortable:
            return min(comfortable, key=lambda h: (expires(readings[h], now), -weighted(h)))
        return max(timed, key=weighted)
    if usable:
        return max(usable, key=lambda h: room(readings[h][1], now))
    return min(homes, key=lambda h: wait(readings[h][1], now))


def shared_problems(command, homes):
    """Signs that an update undid the shared history, checked on every launch; none before any merge."""
    primary, others = homes[0], homes[1:]
    names = SHARED[command]
    def sqlite_home(home):
        try:
            with open(f"{home}/config.toml", "rb") as file:
                value = tomllib.load(file).get("sqlite_home")
        except (OSError, ValueError):  # ValueError covers bad TOML and bad UTF-8
            return None
        return value if isinstance(value, str) else None
    if not (any(os.path.islink(os.path.join(home, name)) for home in others for name in names)
            or command == "cdx" and sqlite_home(primary)):
        return []
    problems = [f"{home}/{name} is not linked to {primary}" for home in others for name in names
                if os.path.realpath(os.path.join(home, name)) != os.path.realpath(os.path.join(primary, name))]
    if command == "cdx":
        for home in homes:
            value = sqlite_home(home)
            if not value or os.path.realpath(os.path.expanduser(value)) != os.path.realpath(primary):
                problems.append(f"{home}/config.toml does not set sqlite_home to {primary}")
        problems += [f"{home} has its own state_5.sqlite" for home in others if os.path.exists(f"{home}/state_5.sqlite")]
    return problems


def log_launch(entry):
    """Append one line to LOG, starting a fresh file past 1 MB; logging never blocks a launch."""
    try:
        if os.path.exists(LOG) and os.path.getsize(LOG) > 1 << 20:
            os.replace(LOG, LOG + ".1")
        with open(LOG, "a") as file:
            file.write(json.dumps(entry) + "\n")
    except OSError:
        pass


def main():
    command = os.path.basename(sys.argv[0])
    tool = TOOLS[command]
    if not tool["program"][0]:
        sys.exit(f"{command}: {'claude' if command == 'cl' else 'codex'} is not on PATH")
    homes, now = tool["homes"], time.time()
    with ThreadPoolExecutor(len(homes)) as pool:
        live = dict(zip(homes, pool.map(tool["live"], homes)))
    readings = {home: reading for home, reading in live.items() if reading}
    save_readings(readings, now)
    saved = {}
    if len(readings) < len(homes):
        saved = saved_readings(tool)
        # A login with no reading at all ranks with the credit-only ones.
        readings = {home: readings.get(home) or saved.get(home, (0, (False, [], None)))[1] for home in homes}
    weights = {home: tool["weight"](home) for home in homes}
    home = pick(homes, readings, weights, now)
    name = os.path.basename(home).lstrip(".").capitalize()
    left = room(readings[home][1], now)
    # A saved reading can be stale, for example when an update changed how a login stores its credentials.
    saved_note = "" if live.get(home) else ", saved reading" if home in saved else ", no reading"
    if left > 0:
        plan = f" of a {weights[home]}x plan" if weights[home] > 1 else ""
        print(f"{command}: {name} ({left:.0f}% left{plan}{saved_note})", file=sys.stderr)
    else:
        frees = wait(readings[home][1], now)
        when = "at an unknown time" if frees == float("inf") else time.strftime("at %H:%M", time.localtime(now + frees))
        print(f"{command}: every login is at a limit; {name} frees up first, {when}{saved_note}", file=sys.stderr)
    try:
        problems = shared_problems(command, homes)
    except Exception as error:  # A launch must never fail on its own health check.
        problems = [f"shared history check failed: {error!r}"]
    if problems:
        script = "claude-share-projects" if command == "cl" else "codex-share-home"
        print(f"{command}: shared history needs repair, run {script}: {problems[0]}"
              + (f" (+{len(problems) - 1} more)" if len(problems) > 1 else ""), file=sys.stderr)
    if sys.argv[1:] == ["--which"]:
        # For scripts: CLAUDE_CONFIG_DIR=$(cl --which) or CODEX_HOME=$(cdx --which). The unnamed ~/.claude
        # prints an empty line, which Claude Code reads like an unset variable.
        print("" if home == tool["unnamed"] else home)
        return
    log_launch({"at": datetime.fromtimestamp(now).isoformat(timespec="seconds"), "tool": command, "picked": home,
                "left": round(left), "live": sorted(h for h, reading in live.items() if reading), "problems": problems})

    env = {key: value for key, value in os.environ.items() if key not in tool["credentials"] and key != tool["variable"]}
    if home != tool["unnamed"]:
        env[tool["variable"]] = home
    args = session_by_name(sys.argv[1:], homes) if command == "cdx" else sys.argv[1:]
    os.execve(tool["program"][0], [*tool["program"], *args], env)


if __name__ == "__main__":
    main()
